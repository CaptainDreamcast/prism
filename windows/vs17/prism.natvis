<?xml version="1.0" encoding="utf-8"?>

<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- ============================ Vectors ============================ -->
  <Type Name="prism::Vector2D">
    <DisplayString>({x}, {y})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
    </Expand>
  </Type>

  <Type Name="prism::Vector3D">
    <DisplayString>({x}, {y}, {z})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
    </Expand>
  </Type>

  <Type Name="prism::Vector2DI">
    <DisplayString>({x}, {y})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
    </Expand>
  </Type>

  <Type Name="prism::Vector3DI">
    <DisplayString>({x}, {y}, {z})</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
    </Expand>
  </Type>

  <!-- ====================== Rectangles / shapes ====================== -->
  <Type Name="prism::GeoRectangle2D">
    <DisplayString>[{mTopLeft} -&gt; {mBottomRight}]</DisplayString>
    <Expand>
      <Item Name="topLeft">mTopLeft</Item>
      <Item Name="bottomRight">mBottomRight</Item>
    </Expand>
  </Type>

  <Type Name="prism::GeoRectangle">
    <DisplayString>[{mTopLeft} -&gt; {mBottomRight}]</DisplayString>
    <Expand>
      <Item Name="topLeft">mTopLeft</Item>
      <Item Name="bottomRight">mBottomRight</Item>
    </Expand>
  </Type>

  <Type Name="prism::Circle2D">
    <DisplayString>center {mCenter}, r={mRadius}</DisplayString>
    <Expand>
      <Item Name="center">mCenter</Item>
      <Item Name="radius">mRadius</Item>
    </Expand>
  </Type>

  <Type Name="prism::Circle">
    <DisplayString>center {mCenter}, r={mRadius}</DisplayString>
    <Expand>
      <Item Name="center">mCenter</Item>
      <Item Name="radius">mRadius</Item>
    </Expand>
  </Type>

  <Type Name="prism::Line2D">
    <DisplayString>{mP1} -&gt; {mP2}</DisplayString>
    <Expand>
      <Item Name="p1">mP1</Item>
      <Item Name="p2">mP2</Item>
    </Expand>
  </Type>

  <Type Name="prism::Line">
    <DisplayString>{mP1} -&gt; {mP2}</DisplayString>
    <Expand>
      <Item Name="p1">mP1</Item>
      <Item Name="p2">mP2</Item>
    </Expand>
  </Type>

  <!-- ============================ Matrix ============================= -->
  <Type Name="prism::Matrix4D">
    <DisplayString>Matrix4D [{m[0][0]} {m[0][1]} {m[0][2]} {m[0][3]} | ...]</DisplayString>
    <Expand>
      <Synthetic Name="[row 0]">
        <DisplayString>{m[0][0]}, {m[0][1]}, {m[0][2]}, {m[0][3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[row 1]">
        <DisplayString>{m[1][0]}, {m[1][1]}, {m[1][2]}, {m[1][3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[row 2]">
        <DisplayString>{m[2][0]}, {m[2][1]}, {m[2][2]}, {m[2][3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[row 3]">
        <DisplayString>{m[3][0]}, {m[3][1]}, {m[3][2]}, {m[3][3]}</DisplayString>
      </Synthetic>
    </Expand>
  </Type>

  <!-- =========================== Animation =========================== -->
  <Type Name="prism::Animation">
    <DisplayString>frame {mFrame}/{mFrameAmount}, t={mNow}/{mDuration}</DisplayString>
    <Expand>
      <Item Name="now">mNow</Item>
      <Item Name="duration">mDuration</Item>
      <Item Name="frame">mFrame</Item>
      <Item Name="frameAmount">mFrameAmount</Item>
    </Expand>
  </Type>

  <!-- ====================== Custom containers ======================= -->
  <Type Name="prism::ListElement_internal">
    <DisplayString>id={mID}, data={mData}{(mIsDataOwned ? " (owned)" : "")}</DisplayString>
    <Expand>
      <Item Name="id">mID</Item>
      <Item Name="data">mData</Item>
      <Item Name="isDataOwned">mIsDataOwned</Item>
    </Expand>
  </Type>

  <Type Name="prism::List">
    <DisplayString>{{ size={mSize} }}</DisplayString>
    <Expand>
      <Item Name="[size]">mSize</Item>
      <Item Name="[nextId]">mIDs</Item>
      <LinkedListItems>
        <Size>mSize</Size>
        <HeadPointer>mFirst</HeadPointer>
        <NextPointer>mNext</NextPointer>
        <ValueNode>mData</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="prism::VectorElement">
    <DisplayString>{mData}{(mIsOwned ? " (owned)" : "")}</DisplayString>
    <Expand>
      <Item Name="data">mData</Item>
      <Item Name="isOwned">mIsOwned</Item>
    </Expand>
  </Type>

  <Type Name="prism::Vector">
    <DisplayString>{{ size={mSize} }}</DisplayString>
    <Expand>
      <Item Name="[size]">mSize</Item>
      <Item Name="[capacity]">mAlloc</Item>
      <ArrayItems>
        <Size>mSize</Size>
        <ValuePointer>mData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="prism::StringMap">
    <DisplayString>{{ size={mSize} }}</DisplayString>
    <Expand>
      <Item Name="[size]">mSize</Item>
      <Item Name="buckets">mBuckets</Item>
    </Expand>
  </Type>

</AutoVisualizer>
